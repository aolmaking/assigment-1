            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "batch"
          ]
        },
        "description": "The body is an array of books, as shown in the assignment. { \"books\": [...] } is also accepted.",
        "body": {
          "mode": "raw",
          "raw": "[\n  {\n    \"title\": \"Future\",\n    \"author\": \"George Orwell\",\n    \"year\": 2020,\n    \"genres\": [\n      \"Science Fiction\"\n    ]\n  },\n  {\n    \"title\": \"To Kill a Mockingbird\",\n    \"author\": \"Harper Lee\",\n    \"year\": 1960,\n    \"genres\": [\n      \"Classic\",\n      \"Fiction\"\n    ]\n  },\n  {\n    \"title\": \"Brave New World\",\n    \"author\": \"Aldous Huxley\",\n    \"year\": 2006,\n    \"genres\": [\n      \"Dystopian\",\n      \"Science Fiction\"\n    ]\n  },\n  {\n    \"title\": \"The Great Gatsby\",\n    \"author\": \"F. Scott Fitzgerald\",\n    \"year\": 1925,\n    \"genres\": [\n      \"Classic\",\n      \"Fiction\"\n    ]\n  },\n  {\n    \"title\": \"Moby Dick\",\n    \"author\": \"Herman Melville\",\n    \"year\": 1851,\n    \"genres\": [\n      \"Adventure\",\n      \"Classic\"\n    ]\n  },\n  {\n    \"title\": \"War and Peace\",\n    \"author\": \"Leo Tolstoy\",\n    \"year\": 1869,\n    \"genres\": [\n      \"Historical Fiction\",\n      \"Philosophy\"\n    ]\n  }\n]",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"At least three books inserted\", function () {",
              "    pm.expect(pm.response.json().insertedCount).to.be.at.least(3);",
              "});",
              "// Save the id of \"Future\" (the first book) to use it in the Q7 log",
              "pm.collectionVariables.set(\"futureId\", pm.response.json().insertedIds[\"0\"]);"
            ]
          }
        }
      ]
