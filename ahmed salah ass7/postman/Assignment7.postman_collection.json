          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Returns 3 books sorted by year descending\", function () {",
              "    const years = pm.response.json().map(b => b.year);",
              "    pm.expect(years).to.have.lengthOf(3);",
              "    pm.expect(years).to.eql([...years].sort((a, b) => b - a));",
              "});"
            ]
          }
        }
