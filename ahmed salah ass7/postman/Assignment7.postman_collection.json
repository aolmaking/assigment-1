    {
      "name": "Q10 - Find Books Published Between 1990 And 2010",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/year?from=1990&to=2010",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "year"
          ],
          "query": [
            {
              "key": "from",
              "value": "1990"
            },
            {
              "key": "to",
              "value": "2010"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"All years are between 1990 and 2010\", function () {",
              "    const books = pm.response.json();",
              "    pm.expect(books).to.be.an(\"array\").that.is.not.empty;",
              "    books.forEach(b => pm.expect(b.year).to.be.within(1990, 2010));",
              "});"
            ]
          }
        }
      ]
    },
